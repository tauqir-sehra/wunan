{
  "name": "@wunan/web",
  "private": true,
  "description": "wunan web app: renders pages and calls the wunan API. Holds no data of its own.",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- vite dev",
    "build": "vite build",
    "preview": "dotenv -e ../../.env -- vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "dotenv -e ../../.env -- playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.68.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@wunan/shared": "*",
    "bits-ui": "2.20.4",
    "clsx": "2.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
