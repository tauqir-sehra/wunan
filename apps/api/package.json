{
  "name": "@wunan/api",
  "private": true,
  "description": "wunan backend: holds all data and rules, exposes the versioned JSON API.",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch src/index.ts",
    "start": "node src/index.ts",
    "check": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- node src/db/migrate.ts",
    "create-founder": "dotenv -e ../../.env -- node scripts/create-founder.ts",
    "reminders:once": "dotenv -e ../../.env -- node scripts/reminders-once.ts",
    "seed:demo": "dotenv -e ../../.env -- node scripts/seed-demo.ts",
    "db:reset-test": "dotenv -e ../../.env -- node scripts/reset-test-db.ts",
    "db:reset": "dotenv -e ../../.env -- node scripts/reset-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@wunan/shared": "*",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.16",
    "nodemailer": "10.3.1",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
