# wunan configuration. Copy to `.env` and adjust. The values below work for local development
# only. For production, generate fresh secrets as described in docs/operator.md and never commit
# your real `.env`.

# Database (the API is the only thing that connects to it)
# compose.yaml (self-hosting) builds DATABASE_URL from this password. Production: `openssl rand -hex 24`
POSTGRES_PASSWORD=
DATABASE_URL=postgres://wunan:wunan@localhost:5432/wunan
TEST_DATABASE_URL=postgres://wunan:wunan@localhost:5432/wunan_test

# Signs sessions and tokens. Production: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0000

# Encrypts members' private contact details in the database (32 bytes, base64).
# Production: `openssl rand -base64 32`. Back it up: losing it makes contact details unreadable.
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS1pbi1wcm9kISE=

# Public address of the site (used in emails and links)
SITE_URL=http://localhost:5173

# Where the web app reaches the API (server to server, never the browser)
API_INTERNAL_URL=http://localhost:3000
API_PORT=3000

# Email (Mailpit catches everything in development: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=wunan <no-reply@localhost>

# Device notifications (Web Push). Leave empty to turn device notifications off.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Place suggestions while typing addresses and areas (a Photon server, https://github.com/komoot/photon).
# Only the typed text is sent, from the API server. Leave empty to turn suggestions off.
PLACES_URL=https://photon.komoot.io
# Optional: "lat,lon" near your community, and a "minLon,minLat,maxLon,maxLat" box to stay inside.
PLACES_BIAS=
PLACES_BBOX=

# Where listing photos are stored (relative to apps/api in development)
PHOTOS_DIR=./photos

# Time zone for return reminders ("the day after it was due"), e.g. Europe/London. compose.yaml only.
TZ=UTC
